{
  // mega-client-worker — internal MEGA storage API.
  // No public URL: only reachable through service bindings from other
  // workers of the same account (env.MEGA_CLIENT.fetch(...)).
  "name": "mega-client-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],

  // MEGA credentials are NOT declared here: set MEGA_EMAIL and
  // MEGA_PASSWORD directly on this worker (wrangler secret put, dashboard,
  // or a secrets_store_secrets binding injected by update-client-account).
  // Both plain secrets/vars and Secrets Store bindings are supported.

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
